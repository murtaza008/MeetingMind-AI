# ── Database (required) ────────────────────────────────────────────────
# Free Neon Postgres: https://neon.tech — create a project, copy the connection string.
DATABASE_URL=""

# ── Auth (required) ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ── AI (required to process meetings) ────────────────────────────────────
# Free key, no card: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""

# ── Google sign-in (optional — free) ─────────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials.
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Stripe (optional) ─────────────────────────────────────────────────────
# Leave every value below blank to run billing in demo mode: switching plans
# just updates the organization's plan in Postgres, no card required anywhere.
# Fill these in with free TEST-mode keys (https://dashboard.stripe.com/test/apikeys)
# to enable real Stripe Checkout instead.
# Only sk_test_ keys are accepted; live keys are refused.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_TEAM=""
STRIPE_PRICE_BUSINESS=""

# ── Public demo (optional) ────────────────────────────────────────────────
# Password of the shared demo account that "Try demo" signs visitors into.
# Generate with: openssl rand -base64 32   (then run: npm run seed:demo)
DEMO_PASSWORD=""
# Protects /api/cron/demo-reset. Vercel Cron sends it as a Bearer token.
# Generate with: openssl rand -hex 32
CRON_SECRET=""
